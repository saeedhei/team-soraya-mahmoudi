{
  "compilerOptions": {
    /* Output / Build Info */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,

    /* Language / Target */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Bundler mode - Module Resolution (Vite bundler mode) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Linting - Type Checking */
    "strict": true,
    "skipLibCheck": true, // ✅ faster, no need to type-check node_modules
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Types */
    "types": [
      "vite/client", // ✅ gives you import.meta.env typing
      "react", // ✅ ensures React 19 JSX types are loaded
      "react-dom",
      "babel__core", // ✅ fixes your missing Babel type errors
      "babel__generator",
      "babel__template",
      "babel__traverse"
    ],

    /* Paths alias */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
